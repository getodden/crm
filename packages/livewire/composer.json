{
    "name": "getodden/crm-livewire",
    "description": "Livewire screens for Odden CRM",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "crm",
        "getodden",
        "livewire"
    ],
    "homepage": "https://odden.io",
    "support": {
        "issues": "https://github.com/getodden/crm/issues",
        "source": "https://github.com/getodden/crm"
    },
    "authors": [
        {
            "name": "CaskStack, LLC",
            "homepage": "https://odden.io"
        }
    ],
    "require": {
        "php": "^8.3",
        "getodden/crm-core": "self.version",
        "getodden/ui": "^0.2",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^3.8 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0 || ^5.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Odden\\Livewire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Odden\\Livewire\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Odden\\Livewire\\LivewireServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
