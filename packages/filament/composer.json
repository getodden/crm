{
    "name": "getodden/crm-filament",
    "description": "Unified Filament CRM Panel & UI Plugin for Odden",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "crm",
        "getodden",
        "filament",
        "filament-plugin",
        "admin-panel"
    ],
    "homepage": "https://odden.io",
    "support": {
        "issues": "https://github.com/getodden/crm/issues",
        "source": "https://github.com/getodden/crm"
    },
    "authors": [
        {
            "name": "CaskStack, LLC",
            "homepage": "https://odden.io"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.9",
        "getodden/crm-core": "self.version",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "getodden/crm-sales": "self.version",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0 || ^5.0"
    },
    "suggest": {
        "getodden/crm-sales": "Adds Deals, Pipelines, Quotes, Sequences, and the Sales Cockpit"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../sales",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../service",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../marketing",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Odden\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Odden\\Filament\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Odden\\Filament\\FilamentServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
